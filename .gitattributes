# Everything is checked out with LF: the kernel fragment and the pins are
# read under Linux from a Windows checkout too.
* text=auto eol=lf
*.rs text eol=lf
*.toml text eol=lf
*.config text eol=lf
# The notices file is compared byte for byte.
lic/release/NOTICES.txt text eol=lf
# Fuzz inputs are bytes: stored and checked out as they are.
tools/fuzz/corpus/** binary
