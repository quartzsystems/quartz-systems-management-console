# QS/MC kernel fragment. Merged onto arch/x86/configs/x86_64_defconfig
# after the pipeline's baseline (EFI stub, baked command line, embedded
# initramfs, xz, devtmpfs, proc, sysfs, tmpfs; no modules, no debug
# information), then resolved with `make olddefconfig`. The orchestrator
# checks the final .config symbol by symbol (tools/build/src/product/kernel.rs).
#
# A console is a small machine, often a virtual one: it runs no
# partition and keeps nothing but its own state. What it needs is a
# load source, a management port, the display and serial port, and the
# drivers of the hypervisors it is likely to be a guest of.

CONFIG_64BIT=y
CONFIG_LOCALVERSION="-qsmc"
# CONFIG_LOCALVERSION_AUTO is not set

# The initramfs is embedded uncompressed and the whole image compressed
# once with xz, which keeps the media UKI under the 32 MiB an El Torito
# boot image can name. No other decompressor is needed.
# CONFIG_KERNEL_GZIP is not set
# CONFIG_RD_GZIP is not set
# CONFIG_RD_BZIP2 is not set
# CONFIG_RD_LZMA is not set
# CONFIG_RD_XZ is not set
# CONFIG_RD_LZO is not set
# CONFIG_RD_LZ4 is not set
# CONFIG_RD_ZSTD is not set
# The image does not carry its own configuration: its bytes do not
# depend on where it was built.
# CONFIG_IKCONFIG is not set

# Networking core: the web server listens on TCP, QSI connects out on
# TCP, DHCP needs a packet socket, the services talk to PID 1 over Unix
# sockets, and the management port may be on a VLAN (base/netd).
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_UNIX=y
CONFIG_PACKET=y
CONFIG_VLAN_8021Q=y

# Supervision (base/supervise): control groups for the services, their
# tasks and memory; seccomp for the confinement of the services that
# face the network (the web server, the QSI client).
CONFIG_CGROUPS=y
CONFIG_CGROUP_PIDS=y
CONFIG_MEMCG=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# The load source (base/loadsource, base/stgd): xfs for QSMCDATA, and a
# mirrored load source served through ublk, which needs io_uring. Disks
# are NVMe, SATA or SCSI.
CONFIG_XFS_FS=y
CONFIG_BLK_DEV_UBLK=y
CONFIG_IO_URING=y
CONFIG_PCI=y
CONFIG_BLK_DEV_NVME=y
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
# Scan in the foreground: disks behind an HBA keep their order from boot
# to boot.
# CONFIG_SCSI_SCAN_ASYNC is not set
# SAS and RAID HBAs on real servers, QS/VS's set for a load source:
# MegaRAID (Dell PERC, in HBA mode too), mpt3sas (Dell HBA330, LSI IT
# mode), smartpqi and hpsa (Microchip, HPE), aacraid (Adaptec), mpi3mr
# (Broadcom 9600).
CONFIG_SCSI_LOWLEVEL=y
CONFIG_MEGARAID_SAS=y
CONFIG_SCSI_MPT3SAS=y
CONFIG_SCSI_SMARTPQI=y
CONFIG_SCSI_HPSA=y
CONFIG_SCSI_AACRAID=y
CONFIG_SCSI_MPI3MR=y

# The ESP, where an update writes the other slot's UKI, and the firmware
# boot entries that choose the slot.
CONFIG_VFAT_FS=y
CONFIG_NLS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_EFIVAR_FS=y

# Removable volumes: the seed volume (FAT, base/seed) and the
# installation media and updates (ISO 9660 on a CD-ROM, a BMC's virtual
# media or a USB stick). VFAT is above.
CONFIG_ISO9660_FS=y
CONFIG_JOLIET=y
CONFIG_BLK_DEV_SR=y
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y

# Physical NICs for the management port: Intel, Broadcom and Mellanox,
# as QS/VS enables them. No firmware is built in.
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_NET_VENDOR_INTEL=y
CONFIG_E1000=y
CONFIG_E1000E=y
CONFIG_IGB=y
CONFIG_IGC=y
CONFIG_IXGBE=y
CONFIG_I40E=y
CONFIG_ICE=y
CONFIG_NET_VENDOR_BROADCOM=y
CONFIG_TIGON3=y
CONFIG_BNXT=y
CONFIG_NET_VENDOR_MELLANOX=y
CONFIG_MLX5_CORE=y
CONFIG_MLX5_CORE_EN=y

# As a guest. virtio: QEMU and KVM (and the tests), Proxmox.
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_SCSI_VIRTIO=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y
# VMware, as QS/400's fragment has it: LSI Logic parallel and SAS,
# PVSCSI, the IDE controller older VMs default to, vmxnet3.
CONFIG_FUSION=y
CONFIG_FUSION_SPI=y
CONFIG_FUSION_SAS=y
CONFIG_VMWARE_PVSCSI=y
CONFIG_ATA_PIIX=y
CONFIG_VMXNET3=y
# Hyper-V Gen2, as QS/400's fragment has it: VMBus, the synthetic NIC,
# disks and keyboard; the display is the EFI framebuffer through
# simpledrm. QS/400's vsock (its guest agent) is left out: a console has
# no guest agent.
CONFIG_HYPERVISOR_GUEST=y
CONFIG_HYPERV=y
CONFIG_HYPERV_NET=y
CONFIG_HYPERV_STORAGE=y
CONFIG_HYPERV_KEYBOARD=y

# The local console (base/panels): the VT on the firmware framebuffer
# through simpledrm, the serial port on the UART, a keyboard.
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_DRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_SYSFB_SIMPLEFB=y
# CONFIG_FB_EFI is not set
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_SERIO_I8042=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_HID=y
CONFIG_USB_HID=y

# The base system: the clock set from the RTC by PID 1 and written back
# by the network service (the kernel does not set it itself), the ACPI
# power button for the orderly shutdown, the DMI identifiers, signalfd
# for PID 1's and the services' signals.
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_CMOS=y
CONFIG_RTC_INTF_SYSFS=y
CONFIG_RTC_INTF_DEV=y
# CONFIG_RTC_HCTOSYS is not set
CONFIG_ACPI_BUTTON=y
CONFIG_DMI=y
CONFIG_DMIID=y
CONFIG_SIGNALFD=y

# Left out: what QS/VS has for running partitions. A console runs none.
# KVM, and vhost with it: no hypervisor.
# CONFIG_VIRTUALIZATION is not set
# CONFIG_KVM is not set
# CONFIG_VHOST_MENU is not set
# CONFIG_VHOST_NET is not set
# Bridges, bonds and tap devices: no virtual Ethernet. The management
# port is one interface, perhaps on a VLAN.
# CONFIG_BRIDGE is not set
# CONFIG_BONDING is not set
# CONFIG_TUN is not set
# VFIO: no device is passed through to anything.
# CONFIG_VFIO is not set
# Huge pages reserved for partitions' memory (defconfig has them).
# CONFIG_HUGETLBFS is not set
# Tape and Fibre Channel: no partition's drives or SAN.
# CONFIG_CHR_DEV_ST is not set
# CONFIG_SCSI_FC_ATTRS is not set
# No packet filter (defconfig has netfilter): nothing listens but the
# web server, and the outbound rule is the services' own.
# CONFIG_NETFILTER is not set
# CONFIG_EXT4_FS is not set
# Nothing wireless, sound or media.
# CONFIG_WIRELESS is not set
# CONFIG_WLAN is not set
# CONFIG_CFG80211 is not set
# CONFIG_BT is not set
# CONFIG_SOUND is not set
# CONFIG_MEDIA_SUPPORT is not set

# Hardening: QS/VS's Phase 11 set (its docs/SECURITY.md), all of it.
#
# The kernel's log is root's alone.
CONFIG_SECURITY_DMESG_RESTRICT=y
# Checked copies to and from user memory, and fortified string calls.
CONFIG_HARDENED_USERCOPY=y
CONFIG_FORTIFY_SOURCE=y
# The allocators: freelists randomized and checked, kmalloc caches
# randomized, caches not merged, lists checked, corruption a panic.
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_RANDOM_KMALLOC_CACHES=y
# CONFIG_SLAB_MERGE_DEFAULT is not set
CONFIG_LIST_HARDENED=y
CONFIG_BUG_ON_DATA_CORRUPTION=y
CONFIG_SCHED_STACK_END_CHECK=y
# Every allocation zeroed, the stack's offset random on each call,
# used registers zeroed on return.
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y
CONFIG_RANDOMIZE_KSTACK_OFFSET_DEFAULT=y
CONFIG_ZERO_CALL_USED_REGS=y
# An oops is a panic, and a panic restarts the console (panic=-1); its
# last messages are kept in the firmware's variables for the next IPL.
CONFIG_PANIC_ON_OOPS=y
CONFIG_PSTORE=y
CONFIG_EFI_VARS_PSTORE=y
# What the baseline already has, held here: the kernel's text read-only,
# its stacks guarded and in vmalloc space, its place random, the
# processors' mitigations on.
CONFIG_STRICT_KERNEL_RWX=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_VMAP_STACK=y
CONFIG_RANDOMIZE_BASE=y
CONFIG_RANDOMIZE_MEMORY=y
CONFIG_CPU_MITIGATIONS=y
# Ptrace only of a process's own descendants.
CONFIG_SECURITY_YAMA=y
# CONFIG_SECURITY_SELINUX is not set
#
# What an appliance never uses, taken away: another kernel loaded or a
# crash kernel's view of this one, hibernation, the physical memory and
# port devices and /proc/kcore, the I/O port calls, 32-bit programs and
# vsyscall, typing into another's terminal, line disciplines loaded on
# demand, binfmt_misc, kprobes and uprobes, the firmware's ACPI
# overlays, the magic SysRq key, debugfs, user namespaces, BPF,
# userfaultfd, the SIT tunnel.
# CONFIG_KEXEC is not set
# CONFIG_CRASH_DUMP is not set
# CONFIG_HIBERNATION is not set
# CONFIG_DEVMEM is not set
# CONFIG_DEVPORT is not set
# CONFIG_PROC_KCORE is not set
# CONFIG_X86_IOPL_IOPERM is not set
# CONFIG_IA32_EMULATION is not set
CONFIG_LEGACY_VSYSCALL_NONE=y
# CONFIG_LEGACY_TIOCSTI is not set
# CONFIG_LDISC_AUTOLOAD is not set
# CONFIG_BINFMT_MISC is not set
# CONFIG_KPROBES is not set
# CONFIG_UPROBE_EVENTS is not set
# CONFIG_UPROBES is not set
# CONFIG_EFI_CUSTOM_SSDT_OVERLAYS is not set
# CONFIG_MAGIC_SYSRQ is not set
# CONFIG_DEBUG_FS is not set
# CONFIG_USER_NS is not set
# CONFIG_BPF_SYSCALL is not set
# CONFIG_USERFAULTFD is not set
# CONFIG_IPV6_SIT is not set
